<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header HUD -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM_CONFIGURATION"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:layout_marginBottom="24dp" />

        <!-- Language Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_scifi_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTERFACE_LANGUAGE"
                android:textSize="10sp"
                android:textColor="@color/primary"
                android:fontFamily="monospace"
                android:layout_marginBottom="16dp" />

            <RadioGroup
                android:id="@+id/rg_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_english"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="EN_US (English)"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_hausa"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="HA_NG (Hausa)"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_yoruba"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="YO_NG (Yorùbá)"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_igbo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="IG_NG (Igbo)"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_pidgin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="PI_NG (Naija Pidgin)"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/primary"
                    android:textSize="14sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- About Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_scifi_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CORE_INFORMATION"
                android:textSize="10sp"
                android:textColor="@color/primary"
                android:fontFamily="monospace"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUILD_v1.0.0_STABLE"
                android:textSize="12sp"
                android:textColor="@color/primary"
                android:fontFamily="monospace"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
