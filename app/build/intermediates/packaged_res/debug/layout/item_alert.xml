<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_scifi_card"
        android:padding="1dp">

        <!-- Severity indicator -->
        <View
            android:id="@+id/view_severity_bar"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/severity_medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/iv_alert_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_alert"
                    app:tint="@color/primary"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tv_alert_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SYSTEM ALERT"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tv_severity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LEVEL: HIGH"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/severity_high"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_alert_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Anomaly detected in sector 7G. Immediate scan required."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/glass_border"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/primary"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tv_alert_location"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SECTOR_7G"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tv_alert_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="T-00:45:12"
                    android:textSize="10sp"
                    android:textColor="@color/primary"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
