<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Corner brackets -->
    <item android:top="40dp" android:left="40dp" android:right="40dp" android:bottom="40dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#4400E5FF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    
    <!-- Center crosshair -->
    <item android:gravity="center" android:width="40dp" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
        </shape>
    </item>
    <item android:gravity="center" android:width="1dp" android:height="40dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
        </shape>
    </item>
</layer-list>
