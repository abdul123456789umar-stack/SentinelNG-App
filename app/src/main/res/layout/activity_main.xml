<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HUD Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                
                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OPERATOR_ACTIVE"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:letterSpacing="0.2"
                    android:fontFamily="monospace" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SENTINEL_NG_v1.0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_current_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN_US"
                android:textSize="10sp"
                android:textColor="@color/primary"
                android:background="@drawable/bg_scifi_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- NLU Search Bar (Futuristic Input) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_scifi_card"
            android:padding="16dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMMAND_INPUT"
                android:textSize="10sp"
                android:textColor="@color/primary"
                android:layout_marginBottom="8dp"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/et_nlu_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Enter command..."
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:background="@null"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btn_nlu_send"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_send"
                    app:tint="@color/primary"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
            
            <ProgressBar
                android:id="@+id/progress_nlu"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary"
                android:visibility="gone"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Grid Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CORE_MODULES"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.2"
            android:layout_marginBottom="16dp"
            android:fontFamily="monospace" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <!-- Crop Doctor -->
            <LinearLayout
                android:id="@+id/btn_crop_doctor"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_scifi_card"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_crop"
                    app:tint="@color/severity_low" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CROP_SCAN"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Health Scan -->
            <LinearLayout
                android:id="@+id/btn_health_scan"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_scifi_card"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_health"
                    app:tint="@color/neon_blue" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BIO_SCAN"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Security -->
            <LinearLayout
                android:id="@+id/btn_security"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_scifi_card"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_security"
                    app:tint="@color/severity_high" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THREAT_INTEL"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Chat -->
            <LinearLayout
                android:id="@+id/btn_chat"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_scifi_card"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/accent" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI_COMMS"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Settings -->
            <LinearLayout
                android:id="@+id/btn_settings"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_scifi_card"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETTINGS"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace" />
            </LinearLayout>

        </GridLayout>

    </LinearLayout>
</ScrollView>
